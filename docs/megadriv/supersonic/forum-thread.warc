	{
		position: relative;
		top: 50%;
		right: 0;
		-webkit-transform: translateY(-50%); -ms-transform: translateY(-50%);transform: translateY(-50%);
	}
	.xbSearchNav #QuickSearch .secondaryControls
	{
		position: absolute;
	}
}
.xbSearchNav #QuickSearchPlaceholder
{
	position: relative;
	top: 50%;
	right: 0;
	-webkit-transform: translateY(-50%); -ms-transform: translateY(-50%);transform: translateY(-50%);
