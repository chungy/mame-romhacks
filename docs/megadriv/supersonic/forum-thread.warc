@media (max-width:800px)
{
	.Responsive #QuickSearchPlaceholder
	{
		display: block;
	}

	.Responsive #QuickSearchPlaceholder.hide
	{
		visibility: hidden;
	}

	.Responsive #QuickSearch
	{
		display: none;
	}

	.Responsive #QuickSearch.show
	{
		display: block;
	}
}



 
.xbSearchNav
{
	min-width: 35px;
}
.xbSearchNav #QuickSearch
{
	right: 0;
	top: 50px;
	background-color: transparent;
